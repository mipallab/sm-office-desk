# Server Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Database (SQLite WAL)
SQLITE_PATH=./data/office.db

# Authentication (Generate >= 64 hex chars for production)
JWT_SECRET=replace-with-64-char-random-hex-secret-in-production
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Storage Driver ('r2' for Cloudflare R2 primary, 'local' for dev/single-VPS disk fallback)
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_BUCKET_NAME=sm-office-desk-screenshots
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRESIGNED_URL_TTL_SECONDS=300
LOCAL_STORAGE_PATH=./data/screenshots

# Company Defaults (Initial seed values for app_settings)
COMPANY_NAME=SM Office
COMPANY_TIMEZONE=Asia/Dhaka
CURRENCY_CODE=BDT
RETENTION_DAYS=90
