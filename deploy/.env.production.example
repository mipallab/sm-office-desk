# ==============================================================================
# SM Office Desk — Production Environment Configuration
# Copy to `deploy/.env.production`, lock permissions (`chmod 600`), and fill in.
# ==============================================================================

# Public domain served by Caddy v2 (automatic Let's Encrypt HTTPS & WSS).
# Use `localhost` only for local Docker smoke tests.
SITE_ADDRESS=desk.example.com

# Server Runtime (must match `https://<SITE_ADDRESS>`)
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=https://desk.example.com

# Database (SQLite WAL stored on persistent Docker volume `sm_office_data:/data`)
SQLITE_PATH=/data/office.db

# Authentication
# REQUIRED in production: >= 32 characters and MUST NOT start with `replace-with` or `dev-only`.
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Screenshot Storage
# Primary: Cloudflare R2 (10 GB Free Tier, $0 egress, private bucket only).
# Fallback: set STORAGE_DRIVER=local to store WebP files on VPS SSD under LOCAL_STORAGE_PATH.
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_BUCKET_NAME=sm-office-desk-screenshots
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRESIGNED_URL_TTL_SECONDS=300
LOCAL_STORAGE_PATH=/data/screenshots

# Company Defaults (used only when bootstrapping a brand-new SQLite database)
COMPANY_NAME=SM Office
COMPANY_TIMEZONE=Asia/Dhaka
CURRENCY_CODE=BDT
RETENTION_DAYS=90

# ==============================================================================
# Host Backup & Health Monitoring (used by deploy/scripts/*.sh)
# ==============================================================================

# Host directory for compressed online SQLite WAL backups (.db.gz + .sha256)
BACKUP_DIR=/var/backups/sm-office-desk
BACKUP_RETENTION_DAYS=14

# Optional Off-Site Backup R2 Bucket (via `aws` CLI or `rclone`)
# CRITICAL: NEVER set BACKUP_R2_BUCKET_NAME equal to R2_BUCKET_NAME!
# Weekly `cleanupOrphanFiles` deletes objects >24h old in R2_BUCKET_NAME not present in `screenshots.storage_key`.
BACKUP_R2_BUCKET_NAME=
BACKUP_R2_ENDPOINT=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=

# Health Monitoring & Alerts
# Optional Discord / Slack / ntfy-compatible JSON webhook URL
ALERT_WEBHOOK_URL=
DISK_WARN_PERCENT=80
