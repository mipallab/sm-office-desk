FROM rust:bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libwebkit2gtk-4.1-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    patchelf \
    libssl-dev \
    pkg-config \
    libclang-dev \
    libxcb1-dev \
    libxrandr-dev \
    libdbus-1-dev \
    libpipewire-0.3-dev \
    libwayland-dev \
    libegl-dev \
    libgbm-dev \
    curl \
    wget \
    file \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
